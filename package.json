{
  "name": "chamak-store-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply chamak-store-web-db --local",
    "db:remote": "wrangler d1 migrations apply chamak-store-web-db --remote",
    "check": "node --check src/index.js && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
